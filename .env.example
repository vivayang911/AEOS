NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
AGENT_PORT=8000
DATABASE_URL=postgresql://aeos:aeos@localhost:5432/aeos
REDIS_URL=redis://localhost:6380
AGENT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
WEB_ORIGIN=http://localhost:3000
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SESSION_MAX_AGE_SECONDS=43200

# Advisory AI is opt-in. The deterministic Mock remains the default for offline acceptance.
ADVISORY_PROVIDER=mock-deterministic
# ADVISORY_PROVIDER=agnes-ai
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# Transactional business events use a zero-network deterministic Mock publisher by default.
OUTBOX_PUBLISHER=mock
OUTBOX_AUTO_DISPATCH=true
OUTBOX_DISPATCH_INTERVAL_MS=5000

# Deterministic internal alert rules. The current notification adapter is Mock-only and needs no credentials.
ALERT_AUTO_PROCESS=true
ALERT_PROCESS_INTERVAL_MS=5000
ANOMALY_SCAN_ENABLED=true
ANOMALY_SCAN_INTERVAL_MS=60000

# DAO configuration validation is shape-only Mock by default. EVM mode performs confirmed read-only RPC/interface checks.
ORGANIZATION_CONFIG_ADAPTER=mock
# ORGANIZATION_CONFIG_ADAPTER=evm-readonly
ORGANIZATION_CONFIG_RPC_URL=
ORGANIZATION_CONFIG_CHAIN_ID=
ORGANIZATION_CONFIG_CONFIRMATION_LAG=2

# Real Attestcoin/USC is opt-in. Mock Evidence remains the safe default.
ATTESTCOIN_ADAPTER=mock
# Per-attempt deadline for bounded read/proof calls (1,000-30,000 ms).
ATTESTCOIN_CALL_TIMEOUT_MS=10000
# Required only when ATTESTCOIN_ADAPTER=usc. Use your own Sepolia RPC endpoint.
SEPOLIA_RPC_URL=
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network/
ATTESTCOIN_PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/

# Governance is observation-only. The explicit Mock adapter cannot submit or authorize proposals.
GOVERNANCE_ADAPTER=mock
# Optional read-only OpenZeppelin Governor mode; no signer or submit method is provided.
# GOVERNANCE_ADAPTER=oz-readonly
# A wallet address is not a Governor. Set these only after a Governor contract and real numeric proposalId exist.
GOVERNANCE_RPC_URL=
GOVERNANCE_CHAIN_ID=
GOVERNOR_ADDRESS=
GOVERNANCE_CONFIRMATION_LAG=2
GOVERNANCE_MIN_CONFIRMATIONS=2

# Guard is read-only; Mock mode is paused and can never produce a READY preflight.
TREASURY_GUARD_ADAPTER=mock
# TREASURY_GUARD_ADAPTER=evm-readonly
TREASURY_GUARD_RPC_URL=
TREASURY_GUARD_CHAIN_ID=
TREASURY_GUARD_ADDRESS=
TREASURY_GUARD_CONFIRMATION_LAG=2

# Safe observation is GET/RPC-only. Mock fails closed; no signer or POST client exists.
SAFE_TRANSACTION_ADAPTER=mock
# SAFE_TRANSACTION_ADAPTER=safe-service-readonly
SAFE_TRANSACTION_SERVICE_URL=
SAFE_TRANSACTION_SERVICE_API_KEY=
SAFE_RPC_URL=
SAFE_CHAIN_ID=
SAFE_ADDRESS=
SAFE_CONFIRMATION_LAG=2

# Deployment preparation/verification only. Never place a private key or mnemonic here.
TREASURY_GUARD_DEPLOY_CHAIN_ID=
TREASURY_GUARD_GOVERNANCE_ADDRESS=
TREASURY_GUARD_GUARDIAN_ADDRESS=
TREASURY_GUARD_DEPLOY_RPC_URL=
TREASURY_GUARD_DEPLOYED_ADDRESS=
# Public verification material only. Never provide a private key or mnemonic.
TREASURY_GUARD_MANIFEST_PATH=
TREASURY_GUARD_MANIFEST_SIGNER_ID=
TREASURY_GUARD_MANIFEST_PUBLIC_KEY_SPKI_BASE64=
TREASURY_GUARD_MANIFEST_SIGNATURE_BASE64=

# Metrics fail closed when unset. Store the real token in the environment secret manager.
METRICS_TOKEN=

# Bounded single-instance cockpit SSE admission. Values outside 1-100 per organization
# or 1-1000 total fall back safely; total is never allowed below the per-organization cap.
COCKPIT_SSE_MAX_PER_ORGANIZATION=8
COCKPIT_SSE_MAX_TOTAL=64


